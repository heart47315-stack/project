EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_SUPABASE_ANON_KEY

# Server / Supabase secrets belong in a server-only environment, never in Expo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
GOOGLE_MAPS_API_KEY=

# Public URL of your server-side Medical AI/RAG endpoint.
EXPO_PUBLIC_MEDICAL_AI_ENDPOINT=https://your-project.supabase.co/functions/v1/ai-chat

# Server-only embedding ingestion variables. Never put these in Expo.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Fine-tuning submission is disabled unless explicitly approved server-side.
FINE_TUNING_APPROVED=NO
