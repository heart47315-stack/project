{
  "expo": {
    "name": "MEDSAFE AI",
    "slug": "medsafe-ai",
    "scheme": "medsafeai",
    "version": "1.1.0",
    "runtimeVersion": "1.0.0",
    "android": {
      "package": "com.medsafeai.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "faf23790-fddd-4b0b-901e-a55720bceef8"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/faf23790-fddd-4b0b-901e-a55720bceef8"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "อนุญาตให้ MEDSAFE AI เข้าถึงตำแหน่งของคุณเพื่อคำนวณเส้นทางปลอดภัย"
      }],
      "expo-web-browser",
      ["expo-notifications", {
        "permissions": ["POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM", "VIBRATE"]
      }]
    ]
  }
}
